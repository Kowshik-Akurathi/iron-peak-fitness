# Backend runtime
NODE_ENV=development
PORT=4000
HOST=127.0.0.1

# PostgreSQL connection. Replace the placeholder locally; never commit real credentials.
DATABASE_URL=postgresql://postgres:change-me@localhost:5432/iron_peak_fitness?schema=public

# Secret placeholders only. Generate environment-specific values outside source control.
SESSION_SECRET=replace-with-a-development-secret-at-least-32-characters
SESSION_COOKIE_NAME=iron_peak_session
SESSION_TTL_HOURS=12
REMEMBER_SESSION_TTL_DAYS=30
ARGON2_MEMORY_COST=19456
ARGON2_TIME_COST=2
ARGON2_PARALLELISM=1

# Browser client origin(s)
FRONTEND_URL=http://localhost:5173

# Logging
LOG_LEVEL=info
